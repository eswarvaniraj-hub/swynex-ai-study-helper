# ==============================================================================
# AI Study Helper - Environment Variables Template
# SWYNEX Internship Task 4 Final AI Project
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy or rename this file to ".env" in the project root:
#    cp .env.example .env   (or copy .env.example .env in PowerShell)
# 2. Replace "your_gemini_api_key_here" with your actual Google Gemini API key.
# 3. How to get a free API key (No credit card required):
#    - Visit https://aistudio.google.com/app/apikey
#    - Sign in with your Google account.
#    - Click "Create API Key" and copy the key.
# 4. NEVER commit your actual ".env" file to GitHub!
# ==============================================================================

# Google Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Identifier (Optional, defaults to gemini-flash-latest)
# Supported free tier options: gemini-flash-latest, gemini-3.8-flash, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-flash-latest
